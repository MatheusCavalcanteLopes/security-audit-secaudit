{
  "name": "secaudit",
  "version": "1.0.0",
  "description": "A CLI security auditing tool: checks vulnerable dependencies, insecure HTTP headers, and leaked secrets in your codebase.",
  "main": "dist/index.js",
  "bin": {
    "secaudit": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "ts-node src/cli.ts",
    "build": "tsc",
    "start": "node dist/cli.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "security",
    "cli",
    "audit",
    "vulnerabilities",
    "secrets-detection",
    "http-headers",
    "devsecops"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/node": "^22.7.4",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}
